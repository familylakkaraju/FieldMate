<Project Sdk="Microsoft.NET.Sdk">

  <!-- Requires a real PostgreSQL 15+ (FIELDMATE_TEST_DB = owner connection string to an admin database).
       Without it the tests are skipped locally; in CI (CI=true) a missing database fails the run instead. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FieldMate.Api\FieldMate.Api.csproj" />
    <ProjectReference Include="..\..\src\FieldMate.Database\FieldMate.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
