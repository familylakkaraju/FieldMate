{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "FieldMate": {
    "Environment": "local"
  },
  "Identity": {
    "Mode": "Oidc",
    "ProviderName": "COGNITO",
    "RequiredClaims": {
      "token_use": "access"
    },
    "UpstreamProviderClaim": "idp",
    "UpstreamSubjectClaim": "idp_subject",
    "ClockSkewSeconds": 60
  },
  "Database": {
    "Name": "fieldmate",
    "Username": "fieldmate_app",
    "MaxPoolSize": 2,
    "CommandTimeoutSeconds": 15
  }
}
